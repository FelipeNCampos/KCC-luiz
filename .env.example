# Shared
APP_NAME=KCC Luiz
APP_ENV=development
APP_DOMAIN=localhost
WWW_APP_DOMAIN=www.localhost

# PostgreSQL
POSTGRES_DB=kcc_luiz
POSTGRES_USER=kcc_user
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=55432
DATABASE_URL=postgresql+psycopg://kcc_user:change_this_database_password@db:5432/kcc_luiz

# Backend
BACKEND_PORT=8000
BACKEND_PUBLIC_PORT=18000
SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=kcc_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# Optional admin seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
SECONDARY_USER_NAME=Oakhill Porter
SECONDARY_USER_EMAIL=example_email
SECONDARY_USER_PASSWORD=example_password
SECONDARY_USER_ROLE=admin
SECONDARY_USER_JOB_TITLE=Porter
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=KCC Luiz

# Frontend build
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://localhost:18000
FRONTEND_PUBLIC_PORT=15173
PROXY_PUBLIC_PORT=18081

# Production-only examples
PUBLIC_HTTP_PORT=127.0.0.1:18080
LETSENCRYPT_EMAIL=admin@example.com

# Traefik production overlay
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CONSTRAINT_LABEL=traefik-public
TRAEFIK_HTTP_ENTRYPOINT=http
TRAEFIK_HTTPS_ENTRYPOINT=https
TRAEFIK_HTTPS_REDIRECT_MIDDLEWARE=https-redirect
TRAEFIK_CERT_RESOLVER=le
